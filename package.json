{
  "name": "damage-report",
  "version": "0.2.0",
  "private": true,
  "description": "Finds damage that spreadsheet software has already done to CSV and Excel files. Runs entirely in the browser.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "bench": "tsx testbench/run.ts",
    "fixbench": "tsx testbench/fixbench.ts",
    "scan": "tsx scripts/scan.ts",
    "study": "tsx scripts/study.ts",
    "genes": "python3 -I scripts/build-gene-data.py",
    "e2e": "node tests/e2e/e2e.cjs",
    "verify": "npm test && npm run build && npm run e2e",
    "local": "npm run build && vite preview --open",
    "preinstall": "node scripts/check-node.cjs",
    "prebuild": "node scripts/check-node.cjs"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "fflate": "^0.8.3",
    "papaparse": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
